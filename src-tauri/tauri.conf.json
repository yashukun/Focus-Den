{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Focus Den",
  "version": "../package.json",
  "identifier": "com.yashukun.focusden",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Focus Den",
        "width": 1180,
        "height": 800,
        "minWidth": 760,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBMzRCQUE0Q0YyNEZFOUMKUldTYy9pVFBwTG8wT2p2VzJselo2ZG9XS1VpY1UwUFdJeXdDMXpRUFJVSU55dWpSSCtybEhpamEK",
      "endpoints": [
        "https://github.com/yashukun/Focus-Den/releases/latest/download/latest.json"
      ]
    }
  }
}
